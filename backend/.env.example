# 服务监听
# 0.0.0.0 = 允许从本机之外访问（前端 dev server 需要走代理连后端，
# 直接访问 API 时也依赖这个绑定）
SERVER_HOST=0.0.0.0
SERVER_PORT=8010

# 本机 ADB
ADB_PATH=adb
ADB_SERVER_HOST=127.0.0.1
ADB_SERVER_PORT=5037

# 远程机器 (MDD agent_server) 引擎
ENGINE_CONNECT_TIMEOUT=5
ENGINE_COMMAND_TIMEOUT=30
# 每台远程机器并发命令连接数（坏连接自愈，满则排队）
REMOTE_ENGINE_POOL_SIZE=4

# 设备保活与指标
DEVICE_OFFLINE_THRESHOLD=2
METRICS_INTERVAL_SECONDS=3

# 文件落地目录
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DOWNLOAD_DIR=./data/downloads
MAX_UPLOAD_BYTES=2147483648
# 落地/暂存文件保留时长（小时，0 = 不清理）
STAGING_MAX_AGE_HOURS=24

# API 鉴权：留空 = 不鉴权；非空时除 /api/v1/health 外都要求
# Authorization: Bearer <token>（下载锚点可用 ?token= 传）
API_AUTH_TOKEN=
