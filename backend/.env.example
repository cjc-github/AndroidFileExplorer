# 服务监听
# 0.0.0.0 = 允许从本机之外访问（前端 dev server 需要走代理连后端，
# 直接访问 API 时也依赖这个绑定）
SERVER_HOST=0.0.0.0
SERVER_PORT=8010

# 本机 ADB
ADB_PATH=adb
ADB_SERVER_HOST=127.0.0.1
ADB_SERVER_PORT=5037

# 远程机器 (MDD agent_server) 引擎
ENGINE_CONNECT_TIMEOUT=5
ENGINE_COMMAND_TIMEOUT=30

# 设备保活与指标
DEVICE_OFFLINE_THRESHOLD=2
METRICS_INTERVAL_SECONDS=3

# 文件落地目录
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DOWNLOAD_DIR=./data/downloads
MAX_UPLOAD_BYTES=2147483648
